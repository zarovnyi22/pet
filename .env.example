# Copy to .env and fill in real values. .env is git-ignored — never commit keys.

# Postgres connection string. localhost is for running the app/tests on the host;
# inside docker compose the api service overrides the host to `db`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reformulation

# Which LLM backend to use: gemini (primary) or groq (fallback). Switching = changing this line.
LLM_PROVIDER=gemini

# Google AI Studio key — https://aistudio.google.com/apikey (needed when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Groq key — https://console.groq.com/keys (needed when LLM_PROVIDER=groq)
GROQ_API_KEY=

# sentence-transformers model for embeddings (384 dims, runs locally on CPU)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking, counted in the embedding model's own tokens (not words). The model truncates input
# at 256 tokens, so CHUNK_SIZE_TOKENS must be <= 254 (2 go to [CLS]/[SEP]). Changing these
# needs a re-ingest: python -m app.ingest data/corpus/
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=40

# Agent loop limits: max tool-calling iterations and wall-clock budget per /reformulate run
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=60
