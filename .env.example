# Copy to .env and fill in real values. .env is git-ignored — never commit keys.

# Postgres connection string. localhost is for running the app/tests on the host;
# inside docker compose the api service overrides the host to `db`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reformulation

# Which LLM backend to use: gemini (primary) or groq (fallback). Switching = changing this line.
LLM_PROVIDER=gemini

# Optional second provider (gemini|groq, must differ from LLM_PROVIDER; empty = none). It takes
# over a call when the primary still answers 503 after its retries, or answers 429; the primary
# is then skipped for 60 s. Needs that provider's key below.
LLM_FALLBACK_PROVIDER=

# Google AI Studio key — https://aistudio.google.com/apikey (needed when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Groq key — https://console.groq.com/keys (needed when LLM_PROVIDER=groq)
GROQ_API_KEY=

# Model names per provider, and the per-request HTTP timeout to the LLM API (seconds)
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30

# reasoning_effort for gpt-oss models on Groq: low | medium | high. Default low (also when the
# line is missing): a /reformulate run then fits Groq's 8K tokens-per-minute limit with room for
# a retry. Set it empty (GROQ_REASONING_EFFORT=) to not send it and use Groq's own default.
GROQ_REASONING_EFFORT=low

# sentence-transformers model for embeddings (384 dims, runs locally on CPU).
# Baked into the Docker image at build time (the container runs with HF_HUB_OFFLINE=1),
# so changing it needs `docker compose build` and a re-ingest.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking, counted in the embedding model's own tokens (not words). The model truncates input
# at 256 tokens, so CHUNK_SIZE_TOKENS must be <= 254 (2 go to [CLS]/[SEP]). Changing these
# needs a re-ingest: python -m app.ingest data/corpus/
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=40

# Wall-clock budget per /reformulate run (seconds); past it the answer is 504 agent_timeout.
# The pipeline makes at most 4 LLM calls per run (plan + choice, each with one retry).
AGENT_TIMEOUT_SECONDS=60

# Log level for the JSON logs on stdout (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
